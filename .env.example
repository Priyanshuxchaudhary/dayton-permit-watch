# Copy this file to .env.local and fill in real values. Never commit the real file.

# Supabase project URL. Exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Exposed to the browser, used for the signed-in user's own session.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key. Server-only, bypasses row-level security.
# The cron routes use this because there's no logged-in user behind a scheduled job.
# Never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail address that digest emails are sent from.
GMAIL_USER=

# A Gmail app password for that address (not the account's normal password).
# Needs 2-Step Verification turned on first: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Any random string you generate yourself, e.g. `openssl rand -hex 32`.
# Vercel sends this as a bearer token when it calls the cron routes, so they
# can reject requests that didn't come from Vercel's scheduler.
CRON_SECRET=
